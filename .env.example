# Copier ce fichier en .env et remplir les valeurs avant de lancer le projet.
# Ne jamais commiter le fichier .env (il est dans .gitignore).

# --- YouTube Data API v3 -----------------------------------------------------------
# Obtenir une cle sur : https://console.cloud.google.com/apis/credentials
# Activer l'API "YouTube Data API v3" dans le projet Google Cloud.
YOUTUBE_API_KEY=your_youtube_data_v3_api_key_here

# --- Groq API (classification rhetorique LLM) --------------------------------------
# Obtenir une cle sur : https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# --- Groq API - rotation de cles (classifier_llm_corpus.py) -------------------------
# Utilise plusieurs comptes Groq pour contourner le quota journalier gratuit.
# Ajoute GROQ_API_KEY_1, _2, _3... (numerotation continue, sans trou).
# Si aucune GROQ_API_KEY_n n'est definie, le script retombe sur GROQ_API_KEY seule.
GROQ_API_KEY_1=your_first_groq_api_key_here
GROQ_API_KEY_2=your_second_groq_api_key_here
GROQ_API_KEY_3=your_third_groq_api_key_here
